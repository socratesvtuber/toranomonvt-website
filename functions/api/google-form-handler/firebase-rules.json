{
  "rules": {
    "form_submissions": {
      ".read": true,
      ".write": true,
      "$submissionId": {
        ".read": true,
        ".write": true,
        "name_hiragana": {
          ".validate": "newData.isString()"
        },
        "name_romaji": {
          ".validate": "newData.isString()"
        },
        "public_flag": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "form_errors": {
      ".read": true,
      ".write": true
    },
    "top_submissions": {
      ".read": true,
      ".write": true,
      "$submissionId": {
        ".read": true,
        ".write": true
      }
    },
    "top_form_errors": {
      ".read": true,
      ".write": true
    },
    "public_members": {
      ".read": true,
      ".write": true,
      "$memberId": {
        ".read": true,
        ".indexOn": ["timestamp", "public_flag"]
      }
    }
  }
}
