# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase project values
# Get these from Firebase Console: https://console.firebase.google.com/

# Your Firebase project API key
FIREBASE_API_KEY=167351734874

# Your Firebase project ID
FIREBASE_PROJECT_ID=toranomonvt-website

# Your Firebase app ID
FIREBASE_APP_ID=1:167351734874:web:ddb5b2cc1d22f2251a3e63

# Your Firebase messaging sender ID
FIREBASE_MESSAGING_SENDER_ID=167351734874

# Optional: Firebase authDomain (usually {project_id}.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=toranomonvt-website.firebaseapp.com

# Optional: Firebase storage bucket (usually {project_id}.appspot.com)
FIREBASE_STORAGE_BUCKET=toranomonvt-website.appspot.com
